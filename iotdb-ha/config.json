{
  "cluster": {
    "id": "iotdb-prod-01"
  },
  "nodes": [
    {
      "id": "iotdb-a",
      "rpc_url": "10.0.0.101:6667",
      "api_url": "http://10.0.0.101:8080"
    },
    {
      "id": "iotdb-b",
      "rpc_url": "10.0.0.102:6667",
      "api_url": "http://10.0.0.102:8080"
    }
  ],
  "monitor": {
    "node_check_interval": "5s",
    "pipe_check_interval": "10s",
    "consistency_check_interval": "10m",
    "remote_http_timeout": "3s",
    "remote_pipe_status_via_session": false,
    "notify_peer_on_up": true
  },
  "alert": {
    "lag_warning_seconds": 5,
    "lag_critical_seconds": 30,
    "cooldown_seconds": 60,
    "webhook_url": ""
  },
  "api": {
    "port": 8080
  },
  "metrics": {
    "enabled": true,
    "port": 9090
  },
  "recovery": {
    "enabled": true,
    "auto_restart_wait": "30s",
    "node_startup_wait": "30s",
    "check_interval": "15s",
    "long_offline_threshold_hours": 2,
    "ha_status_file_path": "data/ha-cluster-status.json",
    "flush_enabled": true,
    "flush_remaining_events_threshold": 10000,
    "flush_cooldown": "5m",
    "flush_eta_seconds": 600,
    "flush_on_stuck": true,
    "flush_futile_backoff_max": 8
  },
  "audit": {
    "enabled": true,
    "interval": "10m",
    "databases": [],
    "tables": [],
    "row_count_tolerance": 1000,
    "critical_threshold": 100000
  },
  "backlog": {
    "enabled": true,
    "interval": "15s",
    "warning_remaining_events": 10000,
    "critical_remaining_events": 500000,
    "warning_eta_seconds": 300,
    "critical_eta_seconds": 3600,
    "stuck_window": "3m",
    "assumed_throughput_eps": 10000,
    "cooldown": "5m"
  }
}
